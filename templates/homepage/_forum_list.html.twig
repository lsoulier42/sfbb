{% for category in categories %}
    <section class="sf-card">
        <header class="sf-card-header">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-folder-tree"></i>
                {{ category.title }}
            </h2>
        </header>
        <div class="sf-card-body p-0">
            {% for forum in category.forumViewModels %}
                <div class="sf-row">
                    <div class="sf-row-icon">
                        <i class="fa-solid fa-folder"></i>
                    </div>
                    <div class="sf-row-main">
                        <a class="sf-row-title" href="{{ path('forum_show', {'forum': forum.id}) }}">
                            {{ forum.title }}
                        </a>
                        {% if forum.subTitle is not empty %}
                            <div class="sf-row-subtitle">{{ forum.subTitle }}</div>
                        {% endif %}
                    </div>
                    <div class="sf-row-stat">
                        <span class="sf-row-stat-value">{{ forum.nbTopics }}</span>
                        <span class="sf-row-stat-label">{{ 'homepage.table.title.topics'|trans }}</span>
                    </div>
                    <div class="sf-row-stat">
                        <span class="sf-row-stat-value">{{ forum.nbMessages }}</span>
                        <span class="sf-row-stat-label">{{ 'homepage.table.title.posts'|trans }}</span>
                    </div>
                    <div class="sf-row-last">
                        {% if forum.lastMessage is not null %}
                            {% include 'shared/component/_last_message.html.twig' with {
                                'message': forum.lastMessage
                            } only %}
                        {% else %}
                            {{ 'forum.label.no_message'|trans }}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p class="sf-empty">{{ 'forum.none_found'|trans }}</p>
            {% endfor %}
        </div>
    </section>
{% else %}
    <section class="sf-card">
        <p class="sf-empty">{{ 'category.none_found'|trans }}</p>
    </section>
{% endfor %}
