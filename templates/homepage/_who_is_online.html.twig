<section class="sf-card">
    <header class="sf-card-header">
        <h2 class="sf-card-title">
            <i class="fa-solid fa-users"></i>
            {{ 'homepage.table.title.online'|trans }}
        </h2>
    </header>
    <div class="sf-card-body">
        <div>
            <span class="sf-who-stat">
                <i class="fa-solid fa-comments"></i>
                {{ 'homepage.label.who_is_online.nb_topics_posted'|trans({'%nbTopics%': who_is_online_vm.nbTopics})|raw }}
            </span>
            <span class="sf-who-stat">
                <i class="fa-solid fa-user-check"></i>
                {{ 'homepage.label.who_is_online.nb_registered_users'|trans({'%nbUsers%': who_is_online_vm.nbRegisteredUsers})|raw }}
            </span>
            <span class="sf-who-stat">
                <i class="fa-solid fa-user-plus"></i>
                {{ 'homepage.label.who_is_online.last_registered_user'|trans() }}
                {% include 'shared/component/_user_link.html.twig' with {
                    'user': who_is_online_vm.lastRegisteredUser
                } only %}
            </span>
        </div>
        <hr class="my-3" />
        <div class="sf-who-online">
            {{ 'homepage.label.who_is_online.roles'|trans }}
            {% for role in who_is_online_vm.roles %}
                <span class="sf-badge {{ role.getClassColor }}">{{ role.getTransKey|trans }}</span>
            {% endfor %}
            <br />
            {{ 'user.label.online'|trans }}
            {% for user in who_is_online_vm.usersOnline %}
                {% include 'shared/component/_user_link.html.twig' with {
                    'user': user
                } only %}
                {% if loop.last == false %},{% endif %}
            {% endfor %}
        </div>
        <p class="sf-who-footer mb-0">
            <i class="fa-solid fa-circle-info me-1"></i>
            {{ 'homepage.label.who_is_online.footer'|trans }}
        </p>
    </div>
</section>
