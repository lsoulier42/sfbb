{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'forum.title.show'|trans({'%forum%': forum.title}) }}
{% endblock %}

{% block content %}
    <div class="sf-page-heading">
        <h1 class="sf-page-title">{{ forum.title }}</h1>
        <div class="sf-page-info">
            <i class="fa-solid fa-user-shield me-1"></i>
            {{ 'forum.label.moderators'|trans }} : {{ 'global.label.none'|trans }}
            <span class="mx-2">•</span>
            <i class="fa-solid fa-eye me-1"></i>
            {{ 'forum.label.users_browsing'|trans }} : {{ 'global.label.none'|trans }}
        </div>
    </div>
    {% include 'forum/_new_topic.html.twig' with {'forum': forum, 'pager': topics} only %}
    <section class="sf-card">
        <header class="sf-card-header">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-comments"></i>
                {{ 'forum.label.topics'|trans }}
            </h2>
            <span class="sf-card-badge">{{ topics.nbResults }}</span>
        </header>
        <div class="sf-card-body p-0">
            {% for topic in topics %}
                <div class="sf-row">
                    <div class="sf-row-icon">
                        <i class="fa-solid fa-folder"></i>
                    </div>
                    <div class="sf-row-main">
                        <a class="sf-row-title" href="{{ path('topic_show', {'topic': topic.id}) }}">
                            {{ topic.title }}
                        </a>
                        <div class="sf-row-subtitle">
                            {% include 'shared/component/_user_link.html.twig' with {
                                'user': topic.author
                            } only %}
                        </div>
                    </div>
                    <div class="sf-row-stat">
                        <span class="sf-row-stat-value">{{ topic.posts.count }}</span>
                        <span class="sf-row-stat-label">{{ 'forum.label.replies'|trans }}</span>
                    </div>
                    <div class="sf-row-stat">
                        <span class="sf-row-stat-value">0</span>
                        <span class="sf-row-stat-label">{{ 'forum.label.views'|trans }}</span>
                    </div>
                    <div class="sf-row-last">
                        {% if topic.lastPost is not null %}
                            {% include 'shared/component/_last_message.html.twig' with {
                                'message': topic.lastPost
                            } only %}
                        {% else %}
                            {{ 'topic.label.no_post'|trans }}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <p class="sf-empty">{{ 'forum.topics.none'|trans }}</p>
            {% endfor %}
        </div>
    </section>
    {% include 'forum/_new_topic.html.twig' with {'forum': forum, 'pager': topics} only %}
{% endblock %}
