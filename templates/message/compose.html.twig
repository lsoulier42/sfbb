{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'message.title.compose'|trans }}
{% endblock %}

{% block content %}
    <section class="sf-card">
        <header class="sf-card-header">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-pen"></i>
                {{ 'message.title.compose'|trans }}
            </h2>
        </header>
        <div class="sf-card-body">
            {% if recipient is not null %}
                <p class="mb-3">
                    {{ 'message.label.to'|trans({'%user%': recipient.username}) }}
                </p>
            {% endif %}
            {{ form_start(form) }}
                {% if form.recipient is defined %}
                    {{ form_row(form.recipient) }}
                {% endif %}
                {{ form_row(form.content) }}
                {{ form_row(form.submit) }}
            {{ form_end(form) }}
            <a href="{{ path('message_inbox') }}" class="btn btn-link px-0">
                <i class="fa-solid fa-arrow-left me-1"></i>
                {{ 'message.label.back'|trans }}
            </a>
        </div>
    </section>
{% endblock %}
