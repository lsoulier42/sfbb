{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'message.title.inbox'|trans }}
{% endblock %}

{% block content %}
    <section class="sf-card">
        <header class="sf-card-header d-flex justify-content-between align-items-center">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-envelope"></i>
                {{ 'message.title.inbox'|trans }}
            </h2>
            <a href="{{ path('message_compose') }}" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-pen me-1"></i>
                {{ 'message.label.compose'|trans }}
            </a>
        </header>
        <div class="sf-card-body">
            {% if conversations is empty %}
                <p class="text-muted mb-0">{{ 'message.none'|trans }}</p>
            {% else %}
                <div class="sf-conversation-list">
                    {% for item in items %}
                        <div class="sf-conversation">
                            <a href="{{ path('message_thread', {'chat': item.chat.id}) }}" class="sf-conversation-link">
                                <div class="sf-row-icon">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <div class="sf-row-main">
                                    <span class="sf-row-title">
                                        {% if item.chat.title is not empty %}
                                            {{ item.chat.title }}
                                        {% elseif item.other is not null %}
                                            {{ item.other.username }}
                                        {% else %}
                                            {{ 'message.label.unknown'|trans }}
                                        {% endif %}
                                    </span>
                                    <div class="sf-row-subtitle">
                                        {% if item.other is not null %}
                                            {{ item.other.username }}
                                        {% else %}
                                            {{ 'message.label.unknown'|trans }}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="sf-conversation-meta">
                                    {% if item.unread > 0 %}
                                        <span class="sf-unread-badge">{{ item.unread }}</span>
                                    {% endif %}
                                    {% if item.lastMessage is not null %}
                                        <small class="sf-conversation-date">
                                            {{ item.lastMessage.createdAt|format_datetime('short', locale='fr') }}
                                        </small>
                                    {% endif %}
                                </div>
                            </a>
                            <span class="d-flex align-items-center gap-2 flex-shrink-0">
                                {% if item.unread > 0 %}
                                    <span class="badge bg-danger rounded-pill">{{ item.unread }}</span>
                                {% endif %}
                                {% if item.lastMessage is not null %}
                                    <small class="text-muted">{{ item.lastMessage.createdAt|format_datetime('short', locale='fr') }}</small>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>
{% endblock %}
