{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'message.title.thread'|trans({'%user%': other is not null ? other.username : ''}) }}
{% endblock %}

{% block content %}
    <section class="sf-card">
        <header class="sf-card-header d-flex justify-content-between align-items-center">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-comments"></i>
                {{ 'message.title.thread'|trans({'%user%': other is not null ? other.username : ''}) }}
            </h2>
            <a href="{{ path('message_inbox') }}" class="btn btn-link btn-sm px-0">
                <i class="fa-solid fa-arrow-left me-1"></i>
                {{ 'message.label.back'|trans }}
            </a>
        </header>
        <div class="sf-card-body">
            {% if messages.nbResults == 0 %}
                <p class="text-muted">{{ 'message.thread.none'|trans }}</p>
            {% else %}
                {% for message in messages %}
                    {% include 'message/_message_block.html.twig' with {'message': message} only %}
                {% endfor %}
                <div class="my-3">
                    {{ pagerfanta(messages) }}
                </div>
            {% endif %}

            {{ form_start(form) }}
                {{ form_row(form.content) }}
                {{ form_row(form.submit) }}
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
