{{ form_start(form) }}
<section class="sf-card">
    <header class="sf-card-header">
        <h2 class="sf-card-title">
            <i class="fa-solid fa-reply"></i>
            {{ 'post.label.new_post'|trans }}
        </h2>
    </header>
    <div class="sf-card-body">
        <div class="sf-info-line">
            <span class="sf-info-line-item">
                <i class="fa-solid fa-user me-1"></i>
                {{ 'post.label.author'|trans }} : <strong>{{ author.username }}</strong>
            </span>
            <span class="sf-info-line-item">
                <i class="fa-solid fa-comments me-1"></i>
                {{ 'post.label.topic'|trans }} : <strong>{{ topic.title }}</strong>
            </span>
        </div>
        <div class="mb-3">
            {{ form_row(form.content) }}
        </div>
        <div class="text-end">
            {{ form_widget(form.submit) }}
        </div>
    </div>
</section>
{{ form_end(form) }}
