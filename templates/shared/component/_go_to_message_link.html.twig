{% set topic_id = message.title is defined ? message.id : message.topic.id %}
{% set ancre_prefix = message.title is defined ? 'topic_' : 'post_' %}
<a class="sf-icon-link ms-1" href="{{ path('topic_show', {'topic': topic_id}) }}#{{ ancre_prefix ~ message.id }}"
   title="{{ 'global.label.last_message'|trans }}" aria-label="{{ 'global.label.last_message'|trans }}">
    <i class="fa-solid fa-arrow-right-to-bracket"></i>
</a>
