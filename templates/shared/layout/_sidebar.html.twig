{% set current_route = app.request.attributes.get('_route') %}
<a href="{{ path('admin_index') }}" class="admin-brand">
    <span class="admin-brand-icon"><i class="fa-solid fa-toolbox"></i></span>
    <span>{{ 'admin.label.sidebar'|trans }}</span>
</a>
<nav class="admin-nav">
    <div class="admin-nav-label">{{ 'admin.label.general'|trans }}</div>
    <a href="{{ path('admin_index') }}" class="admin-nav-item {{ current_route == 'admin_index' ? 'active' }}">
        <i class="fa-solid fa-gauge"></i>
        <span>{{ 'admin.label.dashboard'|trans }}</span>
    </a>

    <div class="admin-nav-label">{{ 'admin.label.forum_config'|trans }}</div>
    <a href="{{ path('admin_category_index') }}" class="admin-nav-item {{ current_route starts with 'admin_category' ? 'active' }}">
        <i class="fa-solid fa-folder-tree"></i>
        <span>{{ 'admin.label.category'|trans }}</span>
    </a>
    <a href="{{ path('admin_forum_index') }}" class="admin-nav-item {{ current_route starts with 'admin_forum' ? 'active' }}">
        <i class="fa-solid fa-list"></i>
        <span>{{ 'admin.label.forum'|trans }}</span>
    </a>
    <a href="{{ path('admin_moderator_index') }}" class="admin-nav-item {{ current_route starts with 'admin_moderator' ? 'active' }}">
        <i class="fa-solid fa-shield-halved"></i>
        <span>{{ 'admin.label.moderator'|trans }}</span>
    </a>

    <div class="admin-nav-label">{{ 'admin.label.user_config'|trans }}</div>
    <a href="{{ path('admin_user_index') }}" class="admin-nav-item {{ current_route starts with 'admin_user' ? 'active' }}">
        <i class="fa-solid fa-users"></i>
        <span>{{ 'admin.label.user'|trans }}</span>
    </a>
    <a href="{{ path('admin_access_index') }}" class="admin-nav-item {{ current_route starts with 'admin_access' ? 'active' }}">
        <i class="fa-solid fa-key"></i>
        <span>{{ 'admin.label.access'|trans }}</span>
    </a>
</nav>
<div class="admin-nav-footer">
    <a href="{{ path('admin_configuration_index') }}" class="admin-nav-item {{ current_route starts with 'admin_configuration' ? 'active' }}">
        <i class="fa-solid fa-sliders"></i>
        <span>{{ 'admin.label.global_config'|trans }}</span>
    </a>
</div>
