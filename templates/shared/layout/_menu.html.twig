<header class="sf-header">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <a href="{{ path('homepage') }}" class="sf-brand">
            <img src="{{ asset('images/discuter.png') }}" alt="logo site" />
            <span>{{ forum_name }}</span>
        </a>
        <nav class="sf-nav" aria-label="{{ 'menu.homepage'|trans }}">
            <a href="{{ path('homepage') }}" class="sf-nav-link">
                <i class="fa-solid fa-house"></i>
                <span class="d-none d-md-inline">{{ 'menu.homepage'|trans }}</span>
            </a>
            {% if user is not null %}
                {% if is_admin(user) %}
                    <a href="{{ path('admin_index') }}" class="sf-nav-link">
                        <i class="fa-solid fa-gauge"></i>
                        <span class="d-none d-md-inline">{{ 'menu.admin'|trans }}</span>
                    </a>
                {% endif %}
                <a href="{{ path('user_edit_profile') }}" class="sf-nav-link">
                    <i class="fa-solid fa-user"></i>
                    <span class="d-none d-md-inline">{{ 'menu.profile'|trans }}</span>
                </a>
                <a href="{{ path('user_members_list') }}" class="sf-nav-link">
                    <i class="fa-solid fa-users"></i>
                    <span class="d-none d-md-inline">{{ 'menu.members_list'|trans }}</span>
                </a>
                <a href="{{ path('message_inbox') }}" class="sf-nav-link">
                    <i class="fa-solid fa-envelope"></i>
                    <span class="d-none d-md-inline">{{ 'menu.messages'|trans }}</span>
                    {% if unread_messages > 0 %}
                        <span class="badge bg-danger rounded-pill ms-1">{{ unread_messages }}</span>
                    {% endif %}
                </a>
                <div class="dropdown">
                    <a href="#" class="sf-nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="notificationsDropdown">
                        <i class="fa-solid fa-bell"></i>
                        <span class="d-none d-md-inline">{{ 'menu.notifications'|trans }}</span>
                        {% if unread_notifications > 0 %}
                            <span class="badge bg-danger rounded-pill ms-1">{{ unread_notifications }}</span>
                        {% endif %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end sf-notification-menu" aria-labelledby="notificationsDropdown">
                        {% if notifications is empty %}
                            <li>
                                <span class="dropdown-item text-muted">{{ 'notification.empty'|trans }}</span>
                            </li>
                        {% else %}
                            {% for notif in notifications %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('message_thread', {'chat': notif.chat.id}) }}">
                                        <i class="fa-solid fa-envelope me-2"></i>
                                        <strong>{{ notif.actor is not null ? notif.actor.username : '—' }}</strong>
                                        <span class="d-block text-truncate">{{ notif.message|striptags|slice(0, 80) }}{% if notif.message|striptags|length > 80 %}…{% endif %}</span>
                                        <small class="d-block text-muted">{{ notif.createdAt|format_datetime('short', locale='fr') }}</small>
                                    </a>
                                </li>
                            {% endfor %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ path('notification_mark_all_read') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('notification-mark-all-read') }}">
                                    <button type="submit" class="dropdown-item">{{ 'notification.mark_all_read'|trans }}</button>
                                </form>
                            </li>
                        {% endif %}
                    </ul>
                </div>
                <a href="{{ path('user_logout') }}" class="sf-nav-link">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="d-none d-md-inline">{{ 'menu.logout'|trans({'%username%': user.username}) }}</span>
                </a>
            {% else %}
                <a href="{{ path('user_login') }}" class="sf-nav-link">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span class="d-none d-md-inline">{{ 'menu.login'|trans }}</span>
                </a>
                <a href="{{ path('user_register') }}" class="sf-nav-link">
                    <i class="fa-solid fa-user-plus"></i>
                    <span class="d-none d-md-inline">{{ 'menu.register'|trans }}</span>
                </a>
            {% endif %}
        </nav>
    </div>
    {% if forum_description is not empty %}
        <p class="sf-header-desc mb-0">{{ forum_description }}</p>
    {% endif %}
</header>
