{% set title = title is defined ? title : 'global.modal.delete.title'|trans %}
{% set csrf_key = csrf_key is defined ? csrf_key : 'delete-item' %}
<button type="button" class="admin-action admin-action-danger"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal"
        data-bs-route="{{ route }}"
        data-csrf="{{ csrf_token(csrf_key) }}"
        title="{{ title }}"
        aria-label="{{ 'global.label.delete'|trans }}">
    <i class="fa-solid fa-trash"></i>
</button>
