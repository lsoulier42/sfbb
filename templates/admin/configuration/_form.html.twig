{% form_theme form 'admin/shared/form/_btn_submit.html.twig' %}
{{ form_start(form) }}
{% embed 'admin/shared/_card.html.twig' with {
    'title': configuration is defined ? 'configuration.title.edit'|trans({'%configKey%': configuration.configKey}) : 'configuration.title.new'|trans,
    'icon': 'fa-sliders'
} %}
    {% block card_actions %}
        <a href="{{ path('admin_configuration_index') }}" class="btn btn-outline-secondary btn-sm btn-icon">
            <i class="fa-solid fa-arrow-left"></i> {{ 'global.label.return'|trans }}
        </a>
    {% endblock %}
    {% block card_body %}
        <div class="row g-3">
            {% for field in form.children %}
                {% if field.vars.name != '_token' and field.vars.name != 'submit' %}
                    <div class="col-12 col-md-6">
                        {{ form_row(field) }}
                    </div>
                {% endif %}
            {% endfor %}
            <div class="col-12 d-flex gap-2 mt-4">
                {{ form_widget(form.submit, {'label': configuration is defined ? 'global.label.update'|trans : 'global.label.create'|trans}) }}
                <a href="{{ path('admin_configuration_index') }}" class="btn btn-outline-secondary btn-icon">
                    <i class="fa-solid fa-xmark"></i> {{ 'global.label.close'|trans }}
                </a>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{{ form_end(form) }}
