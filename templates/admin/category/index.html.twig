{% extends 'base_admin.html.twig' %}

{% block admin_breadcrumb %}
    {{ parent() }}
    <i class="fa-solid fa-chevron-right"></i>
    <span>{{ 'category.title.index'|trans }}</span>
{% endblock %}

{% block sub_title %}
    {{ 'category.title.index'|trans }}
{% endblock %}

{% block content %}
    {% embed 'admin/shared/_card.html.twig' with {
        'title': 'category.title.index'|trans,
        'icon': 'fa-folder-tree'
    } %}
        {% block card_actions %}
            <a href="{{ path('admin_category_new') }}" class="btn btn-primary btn-sm btn-icon">
                <i class="fa-solid fa-plus"></i>
                <span class="d-none d-sm-inline">{{ 'category.label.add_category'|trans }}</span>
            </a>
        {% endblock %}
        {% block card_body %}
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">{{ 'category.label.title'|trans }}</th>
                            <th scope="col">{{ 'category.label.orderNumber'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'global.label.edit'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'category.label.change_order'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'global.label.delete'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <th scope="row">{{ category.id }}</th>
                            <td>
                                <div class="fw-semibold">{{ category.title }}</div>
                                {% if category.forums is not empty %}
                                    <div class="small text-muted">
                                        {{ 'category.label.nb_forums'|trans({'%count%': category.forums|length}) }}
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="admin-badge admin-badge-muted">{{ category.orderNumber }}</span>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('admin_category_edit', {'category': category.id}) }}"
                                   class="admin-action admin-action-primary"
                                   title="{{ 'global.label.edit'|trans }}"
                                   aria-label="{{ 'global.label.edit'|trans }}">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    {% if loop.first == false %}
                                        <a href="{{ path('admin_category_change_order', {'category': category.id, 'direction': 'up'}) }}"
                                           class="admin-action"
                                           title="{{ 'category.label.change_order'|trans }}"
                                           aria-label="{{ 'category.label.change_order'|trans }}">
                                            <i class="fa-solid fa-chevron-up"></i>
                                        </a>
                                    {% endif %}
                                    {% if loop.last == false %}
                                        <a href="{{ path('admin_category_change_order', {'category': category.id, 'direction': 'down'}) }}"
                                           class="admin-action"
                                           title="{{ 'category.label.change_order'|trans }}"
                                           aria-label="{{ 'category.label.change_order'|trans }}">
                                            <i class="fa-solid fa-chevron-down"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="text-end">
                                {% include 'shared/modal/delete_button.html.twig' with {
                                    'route': path('admin_category_delete', {'category': category.id}),
                                    'title': 'category.title.delete_modal'|trans({'%title%': category.title}),
                                    'csrf_key': 'delete-category'
                                } only %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">
                                <div class="admin-empty py-4">
                                    <i class="fa-solid fa-folder-tree"></i>
                                    <p>{{ 'category.none_found'|trans }}</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
