{% form_theme form 'admin/shared/form/_btn_submit.html.twig' %}
{{ form_start(form) }}
{% embed 'admin/shared/_card.html.twig' with {
    'title': category is defined ? 'category.title.edit'|trans({'%title%': category.title}) : 'category.title.new'|trans,
    'icon': 'fa-folder-tree'
} %}
    {% block card_actions %}
        <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary btn-sm btn-icon">
            <i class="fa-solid fa-arrow-left"></i> {{ 'global.label.return'|trans }}
        </a>
    {% endblock %}
    {% block card_body %}
        <div class="row g-3">
            <div class="col-12 col-md-6">
                {{ form_row(form.title) }}
            </div>
            <div class="col-12 d-flex gap-2 mt-4">
                {{ form_widget(form.submit, {'label': category is defined ? 'global.label.update'|trans : 'global.label.create'|trans}) }}
                <a href="{{ path('admin_category_index') }}" class="btn btn-outline-secondary btn-icon">
                    <i class="fa-solid fa-xmark"></i> {{ 'global.label.close'|trans }}
                </a>
            </div>
        </div>
    {% endblock %}
{% endembed %}
{{ form_end(form) }}
