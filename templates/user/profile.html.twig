{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'user.profile.title'|trans({'%user%': user.username}) }}
{% endblock %}

{% block content %}
    <section class="sf-card">
        <header class="sf-card-header">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-id-card"></i>
                {{ 'user.profile.label.table.title'|trans({'%user%': user.username}) }}
            </h2>
        </header>
        <div class="sf-message-body">
            <aside class="sf-message-user">
                {% if user.avatarUrl is not empty %}
                    <img src="{{ user.avatarUrl }}" alt="avatar user" class="sf-avatar-image" />
                {% else %}
                    <div class="sf-avatar">{{ user.username|first|upper }}</div>
                {% endif %}
                <div class="sf-user-username mb-1">{{ user.username }}</div>
                <span class="sf-badge sf-user-role">{{ user.getRoleTitle()|trans }}</span>
            </aside>
            <div class="sf-message-content">
                <h3 class="sf-message-section-title">
                    <i class="fa-solid fa-circle-info"></i>
                    {{ 'user.profile.label.all_about'|trans({'%user%': user.username}) }}
                </h3>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="sf-field">
                            <span class="sf-field-label">{{ 'user.profile.label.firstName'|trans }}</span>
                            <span class="sf-field-value">{{ user.firstName }}</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="sf-field">
                            <span class="sf-field-label">{{ 'user.profile.label.lastName'|trans }}</span>
                            <span class="sf-field-value">{{ user.lastName }}</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="sf-field">
                            <span class="sf-field-label">{{ 'user.profile.label.register_date'|trans }}</span>
                            <span class="sf-field-value">{{ user.createdAt|format_datetime('short', locale='fr') }}</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="sf-field">
                            <span class="sf-field-label">{{ 'user.profile.label.total_messages'|trans }}</span>
                            <span class="sf-field-value">{{ user.getTotalMessages() }}</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="sf-field">
                            <span class="sf-field-label">{{ 'user.profile.label.city'|trans }}</span>
                            <span class="sf-field-value">{{ user.city }}</span>
                        </div>
                    </div>
                </div>
                <hr class="my-3" />
                <h3 class="sf-message-section-title">
                    <i class="fa-solid fa-envelope"></i>
                    {{ 'user.profile.label.contact'|trans }}
                </h3>
                <div class="sf-field">
                    <span class="sf-field-label">{{ 'user.profile.label.email'|trans }}</span>
                    <span class="sf-field-value">{{ user.email }}</span>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
