{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'user.forgot_password.title'|trans }}
{% endblock %}

{% block content %}
    <div class="row justify-content-center sf-auth">
        <div class="col-12 col-sm-9 col-md-6 col-lg-4">
            <section class="sf-card">
                <header class="sf-card-header">
                    <h2 class="sf-card-title">
                        <i class="fa-solid fa-key"></i>
                        {{ 'user.forgot_password.title'|trans }}
                    </h2>
                </header>
                <div class="sf-card-body">
                    <div class="alert alert-warning" role="alert">
                        {{ 'user.forgot_password.coming_soon'|trans }}
                    </div>
                    <div class="text-center">
                        <a href="{{ path('user_login') }}" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            {{ 'user.login.title'|trans }}
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
