{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'user.login.title'|trans }}
{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            {{ form_start(form) }}
            <section class="sf-card">
                <header class="sf-card-header">
                    <h2 class="sf-card-title">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        {{ 'user.login.title'|trans }}
                    </h2>
                </header>
                <div class="sf-card-body">
                    {% if error %}
                        {% set errorMessage = error.messageKey|trans(error.messageData, 'security') %}
                        {% if errorMessage == error.messageKey %}
                            {% set errorMessage = error.messageKey|trans(error.messageData) %}
                        {% endif %}
                        <div class="alert alert-danger" role="alert">
                            {{ errorMessage }}
                        </div>
                    {% endif %}
                    <div class="mb-3">
                        {{ form_row(form.username) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.password) }}
                    </div>
                    <div class="mb-4">
                        {{ form_row(form.rememberMe) }}
                    </div>
                    <div class="text-end">
                        {{ form_widget(form.submit) }}
                    </div>
                </div>
            </section>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
