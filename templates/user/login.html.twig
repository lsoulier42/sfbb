{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'user.login.title'|trans }}
{% endblock %}

{% block content %}
    <div class="row justify-content-center sf-auth">
        <div class="col-12 col-sm-9 col-md-6 col-lg-4">
            {{ form_start(form) }}
            <section class="sf-card">
                <header class="sf-card-header justify-content-center">
                    <h2 class="sf-card-title">
                        {{ 'user.login.connect'|trans }}
                    </h2>
                </header>
                <div class="sf-card-body">
                    {% if error %}
                        {% set errorMessage = error.messageKey|trans(error.messageData, 'security') %}
                        {% if errorMessage == error.messageKey %}
                            {% set errorMessage = error.messageKey|trans(error.messageData) %}
                        {% endif %}
                        <div class="alert alert-danger" role="alert">
                            {{ errorMessage }}
                        </div>
                    {% endif %}
                    <div class="mb-3">
                        {{ form_widget(form.username) }}
                    </div>
                    <div class="mb-3">
                        {{ form_widget(form.password) }}
                    </div>
                    <div class="d-grid gap-2 mb-3">
                        {{ form_widget(form.submit) }}
                        <a class="btn btn-outline-secondary" href="{{ path('user_register') }}">
                            <i class="fa-solid fa-user-plus"></i>
                            {{ 'user.label.create_account'|trans }}
                        </a>
                    </div>
                    <div class="text-center">
                        <a href="{{ path('user_forgot_password') }}" class="sf-forgot-password">
                            {{ 'user.label.forgot_password'|trans }}
                        </a>
                    </div>
                </div>
            </section>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
