{% set user = user is defined ? user : null %}
{% set form_password_field = user != null ? form.newPassword : form.password %}
{{ form_start(form) }}
<section class="sf-card">
    <header class="sf-card-header">
        <h2 class="sf-card-title">
            <i class="fa-solid fa-user-lock"></i>
            {{ 'user.label.table.user_info'|trans }}
        </h2>
    </header>
    <div class="sf-card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                {% if user == null %}
                    {{ form_row(form.username) }}
                {% else %}
                    <label class="form-label">{{ 'user.label.username'|trans }}</label>
                    <div class="sf-form-static">{{ user.username }}</div>
                {% endif %}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.email) }}
            </div>
            {% if user != null %}
                <div class="col-12 col-md-6">
                    {{ form_row(form.currentPassword) }}
                </div>
            {% endif %}
            <div class="col-12 col-md-6">
                {{ form_row(form_password_field.first) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form_password_field.second) }}
            </div>
        </div>
    </div>
    <header class="sf-card-header sf-card-header-secondary">
        <h2 class="sf-card-title">
            <i class="fa-solid fa-address-card"></i>
            {{ 'user.label.table.profile_info'|trans }}
        </h2>
    </header>
    <div class="sf-card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                {{ form_row(form.firstName) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.lastName) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.birthDate) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_row(form.city) }}
            </div>
            {% if user == null %}
                <div class="col-12">
                    {{ form_row(form.agreeTerms) }}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="sf-card-footer">
        {{ form_widget(form.submit) }}
    </div>
</section>
{{ form_end(form) }}
