{% extends 'base.html.twig' %}

{% block sub_title %}
    {{ 'user.member_list.title'|trans }}
{% endblock %}

{% block content %}
    <section class="sf-card">
        <header class="sf-card-header">
            <h2 class="sf-card-title">
                <i class="fa-solid fa-magnifying-glass"></i>
                {{ 'user.member_list.search'|trans }}
            </h2>
        </header>
        <div class="sf-card-body">
            {{ form_start(form) }}
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    {{ form_row(form.username) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_row(form.city) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_row(form.role) }}
                </div>
            </div>
            <div class="text-end mt-3">
                {{ form_widget(form.submit) }}
            </div>
            {{ form_end(form) }}
        </div>
    </section>

    <div class="sf-toolbar justify-content-end">
        <div>
            {{ pagerfanta(members) }}
        </div>
    </div>

    <section class="sf-card">
        <div class="sf-card-body p-0">
            <table class="sf-table">
                <thead>
                <tr>
                    <th scope="col">{{ 'user.label.id'|trans }}</th>
                    <th scope="col">{{ 'user.label.username'|trans }}</th>
                    <th scope="col">{{ 'user.label.last_name'|trans }}</th>
                    <th scope="col">{{ 'user.label.city'|trans }}</th>
                    <th scope="col">{{ 'user.label.registration_date'|trans }}</th>
                    <th scope="col">{{ 'user.label.last_visit'|trans }}</th>
                    <th scope="col">{{ 'user.label.nb_messages'|trans }}</th>
                    <th scope="col">{{ 'user.label.private_message'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for member in members %}
                    <tr>
                        <td>{{ member.id }}</td>
                        <td>
                            {% include 'shared/component/_user_link.html.twig' with {
                                'user': member
                            } only %}
                        </td>
                        <td>{{ member.fullName }}</td>
                        <td>{{ member.city }}</td>
                        <td>{{ member.createdAt|format_datetime('full', locale='fr') }}</td>
                        <td>{{ member.lastConnexion|format_datetime('full', locale='fr') }}</td>
                        <td>{{ member.getTotalPosts }}</td>
                        <td>
                            <i class="fa-regular fa-envelope text-muted" title="{{ 'user.label.private_message'|trans }}"></i>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <div class="sf-toolbar justify-content-end">
        <div>
            {{ pagerfanta(members) }}
        </div>
    </div>
{% endblock %}
